# Gassigeher SaaS Development Environment
# Copy to .env to use: cp .env.development .env

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080
BASE_URL=http://localhost:8080

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_TYPE=sqlite
DATABASE_PATH=./gassigeher.db

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=dev-secret-do-not-use-in-production-1234567890
JWT_EXPIRATION_HOURS=24

# ============================================
# SUPER ADMIN CONFIGURATION
# ============================================
# On first run, Super Admin credentials are written to SUPER_ADMIN_CREDENTIALS.txt
SUPER_ADMIN_EMAIL=admin@localhost

# ============================================
# SAAS CONFIGURATION (Multi-tenant)
# ============================================
# Base domain for tenant subdomains
# For local dev, use gassigeher.local and add entries to /etc/hosts
BASE_DOMAIN=gassigeher.local

# Hetzner DNS API Token (not needed for local dev)
# HETZNER_DNS_TOKEN=

# ============================================
# EMAIL CONFIGURATION
# ============================================
# For development, emails will fail gracefully (logged but not sent)
# Set up Gmail API or SMTP for actual email sending

EMAIL_PROVIDER=gmail

# Gmail API (leave empty for dev - emails will be logged only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=noreply@localhost

# SMTP Alternative (uncomment if using SMTP)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=false
# SMTP_USE_SSL=false

# ============================================
# FILE UPLOADS
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# S3 Storage (disabled for local dev)
USE_S3=false

# Hetzner S3 Configuration (use when USE_S3=true)
# S3_ENDPOINT=fsn1.your-objectstorage.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET_NAME=gassigeher-uploads
# S3_REGION=fsn1
# S3_PUBLIC_URL=https://gassigeher-uploads.fsn1.your-objectstorage.com

# ============================================
# STRIPE PAYMENT (Test Mode)
# ============================================
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# Leave empty to disable Stripe integration

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Contact form email
CONTACT_EMAIL=kontakt@localhost

# ============================================
# LOGGING
# ============================================
LOG_DIR=./logs
LOG_MAX_AGE_DAYS=7
LOG_COMPRESS_SIZE_MB=10
LOG_CONSOLE_OUTPUT=true

# ============================================
# SYSTEM SETTINGS (defaults, configurable via admin UI)
# ============================================
BOOKING_ADVANCE_DAYS=14
CANCELLATION_NOTICE_HOURS=12
AUTO_DEACTIVATION_DAYS=365
