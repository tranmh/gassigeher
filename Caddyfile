# Caddyfile for Gassigeher SaaS
# Wildcard SSL for *.gassigeher.org using Cloudflare DNS challenge

# Global options
{
    # Enable admin API for Prometheus metrics
    # Accessible at http://caddy:2019/metrics from internal network
    admin :2019

    # Prometheus metrics
    servers {
        metrics
    }
}

# Main domain - Landing page and tenant registration
gassigeher.org {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    # API routes for tenant registration
    handle /api/tenants/* {
        reverse_proxy app:8080
    }

    # Landing page routes
    handle /landing/* {
        reverse_proxy app:8080
    }

    # Default: Landing page
    handle {
        reverse_proxy app:8080
    }

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Compression
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/gassigeher.log
        format json
    }
}

# WWW redirect
www.gassigeher.org {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    redir https://gassigeher.org{uri} permanent
}

# Central admin dashboard
admin.gassigeher.org {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    reverse_proxy app:8080

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/admin.log
        format json
    }
}

# Wildcard for all tenant subdomains
# tierheim-goeppingen.gassigeher.org, tierheim-stuttgart.gassigeher.org, etc.
*.gassigeher.org {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    # Serve uploaded files directly from filesystem (when USE_S3=false)
    # This is more efficient than proxying through the app
    handle_path /uploads/* {
        root * /srv/uploads
        file_server
    }

    # All other requests go to the app
    reverse_proxy app:8080

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Compression
    encode gzip zstd

    # Logging with tenant subdomain
    log {
        output file /var/log/caddy/tenants.log
        format json
    }
}
