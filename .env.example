# ==================================================
# Server Configuration
# ==================================================
PORT=8080
BASE_URL=http://localhost:8080  # Base URL for email links (use https://yourdomain.com in production)

# ==================================================
# Deployment Mode Configuration
# ==================================================
# Leave BASE_DOMAIN empty for Simple-Mode (single tenant)
# Set BASE_DOMAIN for SaaS-Mode (multi-tenant via subdomains)
#
# Simple-Mode: BASE_DOMAIN is NOT set
#   - Single organization deployment
#   - Access via BASE_URL directly
#
# SaaS-Mode: BASE_DOMAIN=gassigeher.org
#   - Multi-tenant via subdomains (tierheim-name.gassigeher.org)
#   - Requires PostgreSQL with RLS
#   - Requires S3 storage (recommended)
#
BASE_DOMAIN=

# ============================================
# Database Configuration
# ============================================

# Database Type (sqlite, mysql, or postgres)
# Default: sqlite (no additional configuration needed)
DB_TYPE=sqlite

# SQLite Configuration (default)
DATABASE_PATH=./gassigeher.db

# MySQL Configuration (use if DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=gassigeher
# DB_USER=gassigeher_user
# DB_PASSWORD=your_secure_password

# PostgreSQL Configuration (use if DB_TYPE=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gassigeher
# DB_USER=gassigeher_user
# DB_PASSWORD=your_secure_password
# DB_SSLMODE=disable  # disable, require, or verify-full

# Alternative: Full Connection String (overrides above if set)
# DB_CONNECTION_STRING=mysql://user:pass@localhost:3306/gassigeher
# DB_CONNECTION_STRING=postgres://user:pass@localhost:5432/gassigeher?sslmode=disable

# Connection Pool (MySQL/PostgreSQL only, ignored for SQLite)
# DB_MAX_OPEN_CONNS=25          # Maximum open connections
# DB_MAX_IDLE_CONNS=5           # Maximum idle connections
# DB_CONN_MAX_LIFETIME=5        # Connection lifetime (minutes)

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRATION_HOURS=24

# ============================================
# Super Admin Configuration (Required)
# ============================================
# Email address for the Super Admin account (created automatically on first run)
# This email will receive the initial Super Admin credentials
SUPER_ADMIN_EMAIL=admin@yourshelter.com

# REMOVED: ADMIN_EMAILS (no longer used)
# Admin privileges are now managed via database (Super Admin can promote users via UI)

# ==================================================
# Email Provider Configuration
# ==================================================

# Email Provider (gmail or smtp) - default: gmail
EMAIL_PROVIDER=gmail

# BCC Admin Copy (optional - works with all providers)
# All sent emails will be BCC'd to this address for audit trail
# Leave empty to disable
EMAIL_BCC_ADMIN=

# --------------------------------------------------
# Gmail API Configuration (get these from Google Cloud Console)
# --------------------------------------------------
GMAIL_CLIENT_ID=your-client-id
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_FROM_EMAIL=noreply@gassigeher.com

# --------------------------------------------------
# SMTP Configuration (for Strato, Office365, etc.)
# --------------------------------------------------
# Use when EMAIL_PROVIDER=smtp

# Strato Example:
# SMTP_HOST=smtp.strato.de
# SMTP_PORT=465
# SMTP_USERNAME=noreply@yourdomain.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false

# Office365 Example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@yourdomain.com
# SMTP_PASSWORD=your-password
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Generic SMTP Settings (uncomment when using EMAIL_PROVIDER=smtp):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# ==================================================
# Uploads
# ==================================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ==================================================
# Logging Configuration
# ==================================================
# Log directory (default: ./logs)
LOG_DIR=./logs

# Days to keep log files (default: 30)
LOG_MAX_AGE_DAYS=30

# Compress log files larger than this size in MB (default: 10)
LOG_COMPRESS_SIZE_MB=10

# Also output logs to console (default: true)
# Set to false in production if using only file logging
LOG_CONSOLE_OUTPUT=true

# ==================================================
# System Settings
# ==================================================
BOOKING_ADVANCE_DAYS=14
CANCELLATION_NOTICE_HOURS=12
AUTO_DEACTIVATION_DAYS=365

# ==================================================
# SaaS-Mode Configuration (Only when BASE_DOMAIN is set)
# ==================================================

# --------------------------------------------------
# S3 Object Storage (Hetzner Object Storage / S3-compatible)
# --------------------------------------------------
# Required for SaaS-Mode, optional for Simple-Mode
USE_S3=false
S3_ENDPOINT=fsn1.your-objectstorage.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=gassigeher-uploads
S3_REGION=fsn1
S3_PUBLIC_URL=https://gassigeher-uploads.fsn1.your-objectstorage.com

# --------------------------------------------------
# Stripe Billing (SaaS-Mode only)
# --------------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# --------------------------------------------------
# Rate Limiting (SaaS-Mode enhanced)
# --------------------------------------------------
# Global rate limit (requests per second per IP)
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Brute force protection
BRUTE_FORCE_MAX_ATTEMPTS=3
BRUTE_FORCE_LOCKOUT_BASE=30      # seconds
BRUTE_FORCE_LOCKOUT_MAX=1800     # 30 minutes max

# --------------------------------------------------
# Tenant Registration (SaaS-Mode)
# --------------------------------------------------
# Require registration password for new tenants
TENANT_REGISTRATION_OPEN=true
TENANT_REGISTRATION_PASSWORD=

# --------------------------------------------------
# Central Admin (SaaS-Mode)
# --------------------------------------------------
# Email for the platform-wide central admin
CENTRAL_ADMIN_EMAIL=admin@gassigeher.org

# --------------------------------------------------
# Demo Tenant (SaaS-Mode)
# --------------------------------------------------
# Enable demo tenant at demo.BASE_DOMAIN
DEMO_ENABLED=true
DEMO_RESET_INTERVAL_HOURS=24

# --------------------------------------------------
# DNS/SSL (for SaaS-Mode production with Caddy)
# --------------------------------------------------
# Hetzner DNS API token for wildcard SSL via DNS challenge
# Get from: https://dns.hetzner.com/settings/api-token
HETZNER_DNS_TOKEN=your-dns-api-token

# ==================================================
# Monitoring - Prometheus
# ==================================================
# /metrics endpoint is protected with Basic Auth
# Password is auto-generated on fresh install if weak/empty
# Configure your prometheus.yml with these credentials:
#
# scrape_configs:
#   - job_name: 'gassigeher'
#     basic_auth:
#       username: prometheus
#       password: <METRICS_PASSWORD value>
#     static_configs:
#       - targets: ['localhost:8080']
#
METRICS_USERNAME=prometheus
METRICS_PASSWORD=
