# ==================================================
# Gassigeher Secrets Configuration
# ==================================================
# This file contains all secrets that are auto-generated during
# installation or must be manually set before deployment.
#
# IMPORTANT:
# - Copy this file to .env.secrets before deployment
# - NEVER commit .env.secrets to version control
# - The install script will auto-generate these on first run
# - To change admin password: edit this file and restart server
#
# To generate a secure random password manually:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# ==================================================

# ==================================================
# Database Secrets
# ==================================================
# PostgreSQL password (auto-generated on install)
DB_PASSWORD=

# ==================================================
# Authentication Secrets
# ==================================================
# JWT signing secret - MUST be at least 32 characters
# Used for signing all authentication tokens
JWT_SECRET=

# ==================================================
# Admin Password
# ==================================================
# Choose ONE based on your deployment mode:
#
# SIMPLE MODE (single shelter, no BASE_DOMAIN set):
#   - SUPER_ADMIN_PASSWORD = local shelter administrator
#   - Set SUPER_ADMIN_EMAIL in .env
#   - This is the only admin for your shelter
#
# SAAS MODE (multi-tenant, BASE_DOMAIN is set):
#   - CENTRAL_ADMIN_PASSWORD = platform administrator
#   - Set CENTRAL_ADMIN_EMAIL in .env
#   - Central Admin can impersonate any tenant's Super Admin
#   - Each tenant has their own Super Admin (created during registration)

# Simple Mode only:
SUPER_ADMIN_PASSWORD=

# SaaS Mode only:
CENTRAL_ADMIN_PASSWORD=

# ==================================================
# S3/MinIO Secrets
# ==================================================
# MinIO root credentials (auto-generated for local MinIO)
# For external S3 (Hetzner), set your actual credentials
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ==================================================
# Monitoring Secrets
# ==================================================
# Prometheus metrics endpoint password
METRICS_PASSWORD=

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=

# ==================================================
# External Service API Keys (Manual Configuration)
# ==================================================
# These are NOT auto-generated - you must set them manually

# Cloudflare API token (for wildcard SSL in production)
# Get from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit for your domain
CLOUDFLARE_API_TOKEN=

# Stripe API keys (SaaS-Mode billing only)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP password (for email sending)
SMTP_PASSWORD=

# Gmail API credentials (alternative to SMTP)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Sentry DSN (optional, for error tracking)
# Get from: https://sentry.io
SENTRY_DSN=
