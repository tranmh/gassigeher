# ==================================================
# Gassigeher Configuration
# ==================================================
# Copy this file to .env and configure for your deployment.
# Secrets are stored separately in .env.secrets (see .env.secrets.example)
#
# The install script reads both files:
#   - .env          -> Configuration (this file)
#   - .env.secrets  -> Passwords & API keys (auto-generated or manual)
# ==================================================

# ==================================================
# Server Configuration
# ==================================================
PORT=8080
BASE_URL=http://localhost:8080  # Use https://yourdomain.com in production

# ==================================================
# Deployment Mode Configuration
# ==================================================
# Leave BASE_DOMAIN empty for Simple-Mode (single tenant)
# Set BASE_DOMAIN for SaaS-Mode (multi-tenant via subdomains)
#
# Simple-Mode: BASE_DOMAIN is NOT set
#   - Single organization deployment
#   - Access via BASE_URL directly
#
# SaaS-Mode: BASE_DOMAIN=gassigeher.org
#   - Multi-tenant via subdomains (tierheim-name.gassigeher.org)
#   - Requires PostgreSQL with RLS
#   - Requires S3 storage
#
BASE_DOMAIN=

# ==================================================
# Database Configuration
# ==================================================
# Database Type: sqlite or postgres
# Note: SaaS-Mode requires postgres for Row-Level Security
DB_TYPE=sqlite

# SQLite Configuration (Simple-Mode default)
DATABASE_PATH=./gassigeher.db

# PostgreSQL Configuration (required for SaaS-Mode)
# DB_PASSWORD is in .env.secrets
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gassigeher
DB_USER=gassigeher
DB_SSLMODE=disable  # disable, require, or verify-full

# Connection Pool (PostgreSQL only)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5

# ==================================================
# Authentication
# ==================================================
# JWT_SECRET is in .env.secrets
JWT_EXPIRATION_HOURS=720  # 30 days (720 hours)

# ==================================================
# Admin Configuration
# ==================================================
# Email for Super Admin account (created on first run)
# SUPER_ADMIN_PASSWORD is in .env.secrets (auto-generated)
SUPER_ADMIN_EMAIL=admin@yourshelter.com

# Central Admin email (SaaS-Mode only)
# CENTRAL_ADMIN_PASSWORD is in .env.secrets (auto-generated)
CENTRAL_ADMIN_EMAIL=admin@gassigeher.org

# ==================================================
# Email Provider Configuration
# ==================================================
# Provider: gmail or smtp
EMAIL_PROVIDER=smtp

# BCC Admin Copy (optional - all emails copied to this address)
EMAIL_BCC_ADMIN=

# --------------------------------------------------
# Gmail API Configuration
# --------------------------------------------------
# Credentials in .env.secrets
GMAIL_FROM_EMAIL=noreply@gassigeher.com

# --------------------------------------------------
# SMTP Configuration
# --------------------------------------------------
# SMTP_PASSWORD is in .env.secrets
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# ==================================================
# Uploads
# ==================================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ==================================================
# Logging Configuration
# ==================================================
LOG_DIR=./logs
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS_SIZE_MB=10
LOG_CONSOLE_OUTPUT=true

# ==================================================
# System Settings
# ==================================================
BOOKING_ADVANCE_DAYS=14
CANCELLATION_NOTICE_HOURS=12
AUTO_DEACTIVATION_DAYS=365

# ==================================================
# SaaS-Mode Configuration
# ==================================================
# Only used when BASE_DOMAIN is set

# --------------------------------------------------
# S3 Object Storage
# --------------------------------------------------
# S3_ACCESS_KEY and S3_SECRET_KEY are in .env.secrets
USE_S3=false

# Local MinIO (Docker Compose default):
S3_ENDPOINT=minio:9000
S3_BUCKET_NAME=gassigeher-uploads
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/gassigeher-uploads
S3_USE_SSL=false

# Production (Hetzner Object Storage):
# S3_ENDPOINT=fsn1.your-objectstorage.com
# S3_BUCKET_NAME=gassigeher-uploads
# S3_REGION=fsn1
# S3_PUBLIC_URL=https://gassigeher-uploads.fsn1.your-objectstorage.com
# S3_USE_SSL=true

# --------------------------------------------------
# Stripe Billing (SaaS-Mode)
# --------------------------------------------------
# STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET in .env.secrets
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# --------------------------------------------------
# Rate Limiting
# --------------------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Brute force protection
BRUTE_FORCE_MAX_ATTEMPTS=3
BRUTE_FORCE_LOCKOUT_BASE=30
BRUTE_FORCE_LOCKOUT_MAX=1800

# --------------------------------------------------
# Tenant Registration (SaaS-Mode)
# --------------------------------------------------
TENANT_REGISTRATION_OPEN=true
TENANT_REGISTRATION_PASSWORD=

# --------------------------------------------------
# Demo Tenant (SaaS-Mode)
# --------------------------------------------------
DEMO_ENABLED=true
DEMO_RESET_INTERVAL_HOURS=24

# --------------------------------------------------
# DNS/SSL (SaaS-Mode production with Caddy)
# --------------------------------------------------
# CLOUDFLARE_API_TOKEN is in .env.secrets

# ==================================================
# Monitoring
# ==================================================
# METRICS_PASSWORD is in .env.secrets
METRICS_USERNAME=prometheus

# Grafana (Docker Compose)
# GRAFANA_ADMIN_PASSWORD is in .env.secrets
GRAFANA_ADMIN_USER=admin

# Sentry Error Tracking (optional)
# SENTRY_DSN is in .env.secrets
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
